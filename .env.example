# ---------------------------------------------------------------
# TechWire environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# In production these live in GitHub Secrets (keys) and Variables (public config).
# ---------------------------------------------------------------

# --- AI content engine (ONE of these is required to run the scraper) ---
# Google AI Studio — free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Force a provider: "gemini" or "groq". Leave blank to auto-detect from the keys above.
AI_PROVIDER=

# Optional model overrides
# Google retires Gemini families on a cadence (1.5 in late 2025, 2.5-flash in
# 2026) — retired ids return 404. The scraper self-heals by following the
# replacement model named in the API's 404 message, so this rarely needs setting.
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Unsplash feature images (optional but recommended) ---
# Without a key the scraper falls back to the source article's Open Graph image,
# which is copyrighted by that publisher. An Unsplash key gives you licensed,
# properly attributed images instead — safer for AdSense review.
# Free key: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
# Your registered Unsplash app name — used as utm_source in attribution links.
UNSPLASH_APP_NAME=techwire

# --- Scraper tuning (all optional) ---
MAX_POSTS_PER_RUN=4
MAX_AGE_HOURS=48
LOG_LEVEL=info

# --- Public site config (safe to expose; baked into the static build) ---
NEXT_PUBLIC_SITE_URL=https://techwire.pages.dev
# Only for GitHub Pages PROJECT sites (user.github.io/repo). Leave blank for Cloudflare.
NEXT_PUBLIC_BASE_PATH=

# --- Search engine verification (optional, recommended) ---
# Google Search Console -> Add property -> HTML tag method. Paste ONLY the
# content="..." token here, not the whole <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> Verify -> Meta tag (msvalidate.01 token).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Yandex Webmaster (optional).
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Indexing policy ---
# A /topics/ page is noindex until it holds at least this many posts. Keeps the
# keyword-generated topic space from filling the index with one-post pages.
NEXT_PUBLIC_TOPIC_INDEX_THRESHOLD=3

# --- Google AdSense (leave blank until approved) ---
# Publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSLOT_BELOW_TITLE=
NEXT_PUBLIC_ADSLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSLOT_SIDEBAR=
NEXT_PUBLIC_ADSLOT_FOOTER=

# --- Deployment ---
# Set to write a CNAME file into the build output for a custom domain.
CUSTOM_DOMAIN=
